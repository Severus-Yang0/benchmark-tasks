                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                custom float physxCollision:contactOffset = 0.0002
                custom float physxCollision:restOffset = 0
                double size = 1
                token visibility = "invisible"
                float xformOp:rotateY = -25
                float3 xformOp:scale = (0.006, 0.008, 0.032)
                double3 xformOp:translate = (-0.0067618921878511914, 0.07150000000000001, 0.0525009245925864)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY", "xformOp:scale"]
            }
        }
    }

    def PhysicsRevoluteJoint "lever_joint" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
    )
    {
        custom float cooler:cam_lift = 0.004
        custom float cooler:lever_snap = 90
        custom float cooler:lever_span = 115
        custom float cooler:lever_stiffness = 0.002
        float drive:angular:physics:damping = 0.0002
        float drive:angular:physics:stiffness = 0.002
        float drive:angular:physics:targetPosition = 0
        uniform token drive:angular:physics:type = "force"
        uniform token physics:axis = "Y"
        rel physics:body0 = </Cooler/body>
        rel physics:body1 = </Cooler/lever>
        point3f physics:localPos0 = (0, 0.0715, 0.038)
        point3f physics:localPos1 = (0, 0.0715, 0.038)
        float physics:lowerLimit = -10
        float physics:upperLimit = 118
    }
}

