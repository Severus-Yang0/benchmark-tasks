    def "Looks"
    {
        def Material "tag"
        {
            token outputs:surface.connect = </Site/Looks/tag/pbr.outputs:surface>

            def Shader "pbr"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Site/Looks/tag/tex.outputs:rgb>
                float inputs:roughness = 0.7
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./danger_tag.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Site/Looks/tag/st.outputs:result>
                float3 outputs:rgb
            }
        }
    }

    def "collision"
