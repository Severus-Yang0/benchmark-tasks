#usda 1.0
(
    defaultPrim = "suitcase"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "suitcase"
{
    def "Looks"
    {
        def Material "shell"
        {
            token outputs:surface.connect = </suitcase/Looks/shell/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.25
                float inputs:clearcoatRoughness = 0.1
                color3f inputs:diffuseColor.connect = </suitcase/Looks/shell/tex.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.3
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./suitcase_shell.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </suitcase/Looks/shell/st.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                color3f outputs:rgb
            }
        }

        def Material "zip"
        {
            token outputs:surface.connect = </suitcase/Looks/zip/Shader.outputs:surface>

