#usda 1.0
(
    defaultPrim = "clothes"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "clothes"
{
    def "Looks"
    {
        def Material "shirts_right"
        {
            token outputs:surface.connect = </clothes/Looks/shirts_right/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </clothes/Looks/shirts_right/tex.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.95
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./clothes_right.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </clothes/Looks/shirts_right/st.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                color3f outputs:rgb
            }
        }

        def Material "shirts_left"
        {
            token outputs:surface.connect = </clothes/Looks/shirts_left/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </clothes/Looks/shirts_left/tex.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.95
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./clothes_left.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </clothes/Looks/shirts_left/st.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                color3f outputs:rgb
            }
        }
    }

