#usda 1.0
(
    defaultPrim = "ssd"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "ssd"
{
    def "Looks"
    {
        def Material "body"
        {
            token outputs:surface.connect = </ssd/Looks/body/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </ssd/Looks/body/tex.outputs:rgb>
                float inputs:metallic = 0.6
                float inputs:roughness = 0.35
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./ssd_top.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </ssd/Looks/body/st.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                color3f outputs:rgb
            }
        }

        def Material "m0"
        {
            token outputs:surface.connect = </ssd/Looks/m0/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.0013732007, 0.0013732007, 0.0020508445)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
    }

