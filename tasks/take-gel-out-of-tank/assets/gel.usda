#usda 1.0
(
    defaultPrim = "gel"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "gel"
{
    def "Looks"
    {
        def Material "gel"
        {
            token outputs:surface.connect = </gel/Looks/gel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </gel/Looks/gel/tex.outputs:rgb>
                float inputs:opacity = 0.85
                float inputs:roughness = 0.15
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./gel_lanes.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </gel/Looks/gel/st.outputs:result>
                color3f outputs:rgb
            }
        }
    }

