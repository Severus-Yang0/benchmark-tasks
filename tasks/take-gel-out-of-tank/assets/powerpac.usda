#usda 1.0
(
    defaultPrim = "powerpac"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "powerpac"
{
    def "Looks"
    {
        def Material "grey"
        {
            token outputs:surface.connect = </powerpac/Looks/grey/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6814193, 0.6993936, 0.6814193)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "green_top"
        {
            token outputs:surface.connect = </powerpac/Looks/green_top/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.105649024, 0.34935078, 0.18116204)
                float inputs:metallic = 0
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "front"
        {
            token outputs:surface.connect = </powerpac/Looks/front/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </powerpac/Looks/front/tex.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./pp_panel_face.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </powerpac/Looks/front/st.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                color3f outputs:rgb
            }
        }

        def Material "disp_run"
        {
            token outputs:surface.connect = </powerpac/Looks/disp_run/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                color3f inputs:emissiveColor.connect = </powerpac/Looks/disp_run/tex.outputs:rgb>
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./powerpac_disp_run.png@
                float4 inputs:scale = (3, 3, 3, 1)
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </powerpac/Looks/disp_run/st.outputs:result>
                color3f outputs:rgb
            }
        }

        def Material "disp_stop"
        {
            token outputs:surface.connect = </powerpac/Looks/disp_stop/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                color3f inputs:emissiveColor.connect = </powerpac/Looks/disp_stop/tex.outputs:rgb>
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./powerpac_disp_stop.png@
                float4 inputs:scale = (3, 3, 3, 1)
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </powerpac/Looks/disp_stop/st.outputs:result>
                color3f outputs:rgb
            }
        }

        def Material "jack_black"
        {
            token outputs:surface.connect = </powerpac/Looks/jack_black/Shader.outputs:surface>

