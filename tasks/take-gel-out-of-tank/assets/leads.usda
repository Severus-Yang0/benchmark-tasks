#usda 1.0
(
    defaultPrim = "leads"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "leads"
{
    def "Looks"
    {
        def Material "black"
        {
            token outputs:surface.connect = </leads/Looks/black/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.0008404889, 0.0008404889, 0.0010890994)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "red"
        {
            token outputs:surface.connect = </leads/Looks/red/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45626345, 0.0020508445, 0.0020508445)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
    }

    def Xform "lead_black_0"
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 0.01)
        double3 xformOp:translate = (0, 0, -1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Cylinder "geom" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 1
            rel material:binding = </leads/Looks/black>
            double radius = 0.002
        }
    }

